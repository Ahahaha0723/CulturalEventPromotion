    {
      "id": "S03",
      "name": "让材料和质感承担主题意义",
      "adoption": "限定调用",
      "mechanism": "材质与真实感",
      "sourceCases": [
        "演出-097",
        "展览-002"
      ],
      "rule": "质感必须能解释主题、剧情或制作过程；材料可以成为主视觉，活动类型和功能信息仍要独立。",
      "conditions": [
        "活动主题本身涉及材料、工艺、结构或可解释的叙事隐喻",
        "已有资料支持材质与内容的关系",
        "目标受众可理解隐喻；没有依据时改用直接主题对象"
      ],
      "actions": [
        "先写一句“这种材料为何属于这个主题”，再决定摄影、扫描或纹理表现。",
        "保留一个主要材质方向，避免以无关纹理堆叠制造复杂度。",
        "题名与功能区选择稳定底色或留白，不让纹理穿过所有文字。",
        "跨到戏曲、音乐节等新题时重选材料；不能只更换题名。"
      ],
      "avoid": [
        "把逼真或粗糙自动当作主题相关",
        "用生成的质感暗示未经确认的历史工艺或实物身份",
        "直接复制参考中的材质、构图与题名关系"
      ],
      "checks": [
        "材质与主题联系有brief依据；没有依据时降级为装饰。",
